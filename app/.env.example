# ShaSwap app — environment template. Copy to `.env.local` (gitignored) for local
# dev, or set these as server env vars in deployment (e.g. DigitalOcean). NO secrets
# belong in this committed template.

# Blockfrost project id. Server-only: it is read in getDataProvider() / route handlers and
# never sent to the browser. When set, the data-access seam defaults to the real Blockfrost
# provider; when unset, it falls back to the offline MockProvider.
#
# Its PREFIX must MATCH NEXT_PUBLIC_NETWORK below — a "preprod..." key needs
# NEXT_PUBLIC_NETWORK=preprod, a "mainnet..." key needs =mainnet, etc. The app REFUSES to
# start on a mismatch (Blockfrost picks the chain from the key prefix, so a mismatch would
# silently read the wrong network).
BLOCKFROST_PROJECT_ID=

# Optional: force the backing provider regardless of the key. One of: blockfrost | mock.
# In production the app REFUSES to start on the mock unless DATA_PROVIDER=mock is set
# explicitly (so a missing key can't silently serve fake pools).
# DATA_PROVIDER=blockfrost

# Optional: public site origin, used to resolve absolute OG/Twitter share-image URLs.
# Defaults to http://localhost:3000 for local dev; set your real domain on deploy.
# NEXT_PUBLIC_SITE_URL=https://shaswap.example

# Optional: target network for the whole app (default preprod). One of:
# preprod | preview | mainnet. Build-time inlined into the client bundle. Selects the
# per-network deployment identities (addresses, reference scripts) in
# src/lib/chain/deployment.ts. Contracts are live on preprod; mainnet is scaffolded but
# not yet deployed (tx-building is disabled there until it is).
# NEXT_PUBLIC_NETWORK=preprod

# Optional: server log threshold. One of: debug | info (default) | warn | error.
# In production, logs are emitted as one JSON object per line (stdout) for log capture.
# LOG_LEVEL=info

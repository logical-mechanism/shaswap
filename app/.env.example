# ShaSwap app — environment template. Copy to `.env.local` (gitignored) for local
# dev, or set these as server env vars in deployment (e.g. DigitalOcean). NO secrets
# belong in this committed template.

# Blockfrost PREPROD project id (starts with "preprod..."). Server-only: it is read
# in getDataProvider() / route handlers and never sent to the browser. When set, the
# data-access seam defaults to the real Blockfrost provider; when unset, it falls back
# to the offline MockProvider.
BLOCKFROST_PROJECT_ID=

# Optional: force the backing provider regardless of the key. One of: blockfrost | mock.
# DATA_PROVIDER=blockfrost

# Optional: target network for the wallet/UI (default preprod). One of:
# preprod | preview | mainnet. The deployed contracts are on preprod.
# NEXT_PUBLIC_NETWORK=preprod

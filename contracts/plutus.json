    "shaswap/types/MintRedeemer": {
      "title": "MintRedeemer",
      "description": "Pool mint policy redeemer: create a pool (mint NFT + full LP supply into it)\n or close it (burn-only).",
      "anyOf": [
        {
          "title": "Create",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Close",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        }
      ]
    },
    "shaswap/types/OrderDatum": {
      "title": "OrderDatum",
      "description": "Order UTXO datum — the intent (§5.1). Bidirectional against one pool whose\n pair is `(asset_a, asset_b)`: `sell_a = True` sells `sell_amount` of `asset_a`\n for `asset_b`; `sell_a = False` sells `sell_amount` of `asset_b` for `asset_a`.\n `limit` is the minimum amount of the *bought* asset — the per-order floor\n (§5.2.5). Either asset may be ADA or a native token.",
      "anyOf": [
        {
          "title": "OrderDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "owner",
              "$ref": "#/definitions/cardano~1address~1Credential"
            },
            {
              "title": "sell_a",
              "$ref": "#/definitions/Bool"
            },
            {
              "title": "sell_amount",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "limit",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "tip",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "partial",
              "$ref": "#/definitions/Bool"
            },
            {
              "title": "deadline",
              "description": "Optional settlement deadline (POSIX ms). If `Some(d)`, a settlement may\n only include this order while the tx is valid no later than `d` (the tx's\n finite upper validity bound ≤ d). Owner reclaim is always allowed (§5.1),\n so an expired order is never stuck.",
              "$ref": "#/definitions/Option<Int>"
            }
          ]
        }
      ]
    },
    "shaswap/types/OrderRedeemer": {
      "title": "OrderRedeemer",
      "description": "Order spend redeemer: join a settlement (defer to `S`) or owner-reclaim.",
      "anyOf": [
        {
          "title": "Settle",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Reclaim",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        }
      ]
    },
    "shaswap/types/PoolDatum": {
      "title": "PoolDatum",
      "description": "Pool UTXO datum (§5.1). Reserves are read from the UTXO *value*; `k` is NOT\n stored. Identity (`nft`) + the traded pair (`asset_a`, `asset_b`) + static fee.\n Either asset may be ADA. Distinct shape (5 fields) from `OrderDatum` (7).",
      "anyOf": [
        {
          "title": "PoolDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "nft",
              "$ref": "#/definitions/shaswap~1types~1AssetId"
            },
            {
              "title": "asset_a",
              "$ref": "#/definitions/shaswap~1types~1AssetId"
            },
            {
              "title": "asset_b",
              "$ref": "#/definitions/shaswap~1types~1AssetId"
            },
            {
              "title": "fee_num",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "fee_den",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "shaswap/types/PoolRedeemer": {
      "title": "PoolRedeemer",
      "description": "Pool spend redeemer.",
      "anyOf": [
        {
          "title": "PoolSettle",
          "description": "Spent inside a settlement: pool owns its `k` non-decreasing check (§5.4\n split) and defers the rest to `S`.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "LpAction",
          "description": "LP deposit/withdraw (share-token based, §6 LP model).",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        },
        {
          "title": "ClosePool",
          "description": "Tear down a created-but-never-seeded pool (held == total_lp ⟺ circ == 0):\n burn the NFT + full LP supply. Post-seed pools are immortal (the locked\n MIN_LIQ can never be reassembled), so reserves can't be stolen this way.",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        }
      ]
    },
    "shaswap/types/SettlementRedeemer": {
      "title": "SettlementRedeemer",
      "description": "The solver-supplied settlement witness (the redeemer of the withdraw-0\n settlement validator). Clearing price is an exact rational (no floats):\n `price = price_num / price_den` is the amount of `asset_b` per unit of\n `asset_a`. `asset_a`/`asset_b`/`pool_nft` are solver-declared identities,\n *verified* on-chain (assets by conservation, NFT by continuity) so settlement\n never parses the PoolDatum and stays curve-agnostic.",
      "anyOf": [
        {
          "title": "SettlementRedeemer",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "price_num",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "price_den",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "asset_a",
              "$ref": "#/definitions/shaswap~1types~1AssetId"
            },
            {
              "title": "asset_b",
              "$ref": "#/definitions/shaswap~1types~1AssetId"
            },
            {
              "title": "pool_nft",
              "$ref": "#/definitions/shaswap~1types~1AssetId"
            },
            {
              "title": "fills",
              "description": "Per-order fill amount (canonical input order; one entry per order input).\n `fills[i] == sell_amount` is a full fill; `fills[i] < sell_amount` is a\n partial fill (requires `partial == True`) producing a remainder UTXO.",
              "$ref": "#/definitions/List<Int>"
            }
          ]
        }
      ]
    }
